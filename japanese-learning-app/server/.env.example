# Backend Server Port
PORT=5000

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database URL
# Example: postgresql://username:password@localhost:5432/kanaforge
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kanaforge

# Firebase Admin SDK Credentials
# Option 1: Provide project ID and service account credentials via environment variables
FIREBASE_PROJECT_ID=kana-forge
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@kana-forge.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option 2: Path to downloaded Firebase service account JSON key file
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# AI APIs (Server-Side Secure Keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
