# Frontend API URL (leave empty in dev to use Vite proxy /api)
VITE_API_URL=

# Firebase Client Configuration (from Firebase Web App Settings)
VITE_FIREBASE_API_KEY=AIzaSyDummyKeyForDevelopment123456789
